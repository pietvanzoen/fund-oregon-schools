    },
    {
      "from": "levy",
      "to": "district",
      "label": "stays with the district; up to a cap, it isn't subtracted from its State School Fund grant",
      "cite": "[SRC:legislature/ors/ors327.html]"
    },
    {
      "from": "formula",
      "to": "district",
      "label": "general purpose, transportation and high-cost disability grants, minus the district's local revenue",
      "cite": "[SRC:legislature/ors/ors327.html]"
    },
    {
      "from": "sia",
      "to": "district",
      "label": "grants on top of the State School Fund",
